<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
	 <EnableHarmony>true</EnableHarmony>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="i18n\de.json" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="i18n\de.json" />
  </ItemGroup>
	
  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.1" />
    <PackageReference Include="Pathoschild.Stardew.ModTranslationClassBuilder" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
	  <ContentPacks Include="content_packs/[CP] Love Festival" Version="$(Version)" />
  </ItemGroup>
	
  <ItemGroup>
    <Folder Include="content_packs\[CP] Love Festival Default Dates\assets\" />
    <Folder Include="content_packs\[CP] Love Festival\i18n\" />
    <Folder Include="content_packs\[CP] Love Festival\big_craftables\" />
    <Folder Include="content_packs\[CP] Love Festival\shops\" />
    <Folder Include="[CP] Love Festival Default Dates\" />
  </ItemGroup>
    
  <PropertyGroup>
	<IgnoreModFilePaths>assets/valentines_sheet.ase, assets/Town-LoveFestival.tmx, assets/valentines_sheet.tsx, assets/.characterSheet.png, assets/.Festivals.png, assets/.winter_town.png, assets/.paths.png, assets/.winter_outdoorsTileSheet.png</IgnoreModFilePaths>	
  </PropertyGroup>

</Project>
